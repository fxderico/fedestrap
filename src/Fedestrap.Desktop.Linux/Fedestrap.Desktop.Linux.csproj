<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<RootNamespace>Fedestrap.Desktop.Linux</RootNamespace>
		<AssemblyName>Fedestrap</AssemblyName>
		<RuntimeIdentifiers>linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64</RuntimeIdentifiers>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia.Wayland" Version="12.1.1" />
		<ProjectReference Include="..\Fedestrap.Desktop\Fedestrap.Desktop.csproj" />
		<ProjectReference Include="..\Fedestrap.Platform.Linux\Fedestrap.Platform.Linux.csproj" />
	</ItemGroup>
</Project>
