<base:WpfUiWindow
    x:Class="Fedestrap.UI.Elements.ContextMenu.ChangePasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Fedestrap.UI.Elements.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="380"
    Height="420"
    MinWidth="340"
    MinHeight="380"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="Change Password"
            Padding="8"
            Icon="pack://application:,,,/Fedestrap.png"
            MinimizeToTray="False"
            ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="16,8,16,8">

            <TextBlock Text="Current password" FontWeight="SemiBold" Margin="0,4,0,4"/>
            <ui:PasswordBox x:Name="OldPasswordBox" PlaceholderText="Your current password"/>

            <TextBlock Text="New password" FontWeight="SemiBold" Margin="0,14,0,4"/>
            <ui:PasswordBox x:Name="NewPasswordBox" PlaceholderText="At least 8 characters"/>

            <TextBlock Text="Confirm new password" FontWeight="SemiBold" Margin="0,14,0,4"/>
            <ui:PasswordBox x:Name="ConfirmPasswordBox" PlaceholderText="Type it again"/>

            <TextBlock x:Name="StatusText" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        </StackPanel>

        <Grid Grid.Row="2" Margin="16,8,16,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" Appearance="Secondary" Click="Cancel_Click"/>
                <ui:Button x:Name="SaveBtn" Content="Change password" Appearance="Primary" Margin="8,0,0,0" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</base:WpfUiWindow>
